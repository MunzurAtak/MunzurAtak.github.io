---
import { t, links, type Lang } from '../data/content';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const h = t[lang].hero;
// Keep hyphenated words (e.g. "end-to-end") from breaking at the hyphen
const words = (text: string) => text.split(' ').map((w) => ({ w, nw: w.includes('-') }));
const partsA = words(h.headlineA);
const partsB = words(h.headlineB);
// Decorative bubble widths for the teaser (illustrates the debate format, not results)
const rounds = [
  ['92%', '70%'],
  ['80%', '88%'],
  ['96%', '64%'],
  ['74%', '90%'],
  ['88%', '76%'],
];
---

<section class="wrap hero" id="top">
  <div class="pitch">
    <p class="eyebrow">{h.role}</p>
    <h1>
      {partsA.map((p, i) => <Fragment>{i ? ' ' : ''}{p.nw ? <span class="nw">{p.w}</span> : p.w}</Fragment>)}{' '}
      <span class="accent">{partsB.map((p, i) => <Fragment>{i ? ' ' : ''}{p.nw ? <span class="nw">{p.w}</span> : p.w}</Fragment>)}</span>
    </h1>
    <p class="sub">{h.sub}</p>
    <p class="badge"><span class="dot" aria-hidden="true"></span><span>{h.badgeA} <strong>{h.badgeB}</strong></span></p>
    <div class="ctas">
      <a class="btn btn-primary" href={`mailto:${links.email}`}>
        {h.cta}
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
      </a>
      <a class="btn" href={links.github} rel="me">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21"></path></svg>
        GitHub
      </a>
      <a class="btn" href={links.linkedin} rel="me">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2zM4 6a2 2 0 1 0 0-4 2 2 0 0 0 0 4z"></path></svg>
        LinkedIn
      </a>
      <a class="btn" href={h.cvHref} download>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12M7 10l5 5 5-5M5 21h14"></path></svg>
        {h.cv}
      </a>
    </div>
  </div>

  <a class="teaser card" href="#research">
    <span class="t-head mono"><span>{h.teaser.label}</span><span>{h.teaser.meta}</span></span>
    <span class="t-title">{h.teaser.title}</span>
    <span class="t-legend mono">
      <span><i class="sw sw-a" aria-hidden="true"></i>{h.teaser.test}</span>
      <span class="muted"><i class="sw sw-b" aria-hidden="true"></i>{h.teaser.opp}</span>
    </span>
    <span class="t-grid" aria-hidden="true">
      {
        rounds.map(([a, b], i) => (
          <span class="t-col">
            <span class="bub bub-a" style={`width:${a}`} />
            <span class="bub bub-b" style={`width:${b}`} />
            <span class="judge">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7" /></svg>
            </span>
            <span class="r mono">R{i + 1}</span>
          </span>
        ))
      }
    </span>
    <span class="t-body">{h.teaser.body}</span>
    <span class="t-foot">
      <span class="mono muted">{h.teaser.foot}</span>
      <span class="t-link">
        {h.teaser.link}
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
      </span>
    </span>
  </a>
</section>

<div class="wrap">
  <dl class="stats">
    {
      h.stats.map((s) => (
        <div class="stat">
          <dt class="mono">{s.small}</dt>
          <dd>{s.big}</dd>
        </div>
      ))
    }
  </dl>
</div>

<style>
  .hero {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(40px, 5vw, 72px);
    padding-top: clamp(40px, 7vw, 96px);
  }
  .pitch {
    flex: 1 1 540px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .pitch .eyebrow {
    margin: 0;
  }
  h1 {
    margin: 0;
    font-size: clamp(36px, 5.2vw, 66px);
    line-height: 1.04;
    letter-spacing: -0.035em;
    font-weight: 600;
    text-wrap: balance;
  }
  .accent {
    color: var(--accent);
  }
  .nw {
    white-space: nowrap;
  }
  .sub {
    margin: 0;
    font-size: 18px;
    line-height: 1.55;
    color: var(--muted);
    max-width: 560px;
  }
  .badge {
    margin: 0;
    display: inline-flex;
    align-self: flex-start;
    align-items: center;
    gap: 10px;
    border: 1px solid var(--line);
    background: var(--surface);
    border-radius: 999px;
    padding: 10px 16px;
    font-size: 14px;
    line-height: 1.35;
  }
  .badge strong {
    font-weight: 600;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--ok);
    box-shadow: 0 0 0 4px var(--ok-soft);
    flex: none;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    padding-top: 4px;
  }

  .teaser {
    flex: 1 1 380px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 24px;
    text-decoration: none;
    transition: border-color 0.15s ease;
  }
  .teaser:hover {
    border-color: var(--ink);
  }
  .t-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 4px 12px;
    white-space: nowrap;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .t-title {
    font-size: 24px;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }
  .t-legend {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px 12px;
    font-size: 12px;
  }
  .t-legend span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .muted {
    color: var(--muted);
  }
  .sw {
    width: 10px;
    height: 10px;
    border-radius: 3px;
    display: inline-block;
  }
  .sw-a,
  .bub-a {
    background: var(--accent);
  }
  .sw-b,
  .bub-b {
    background: var(--neutral);
  }
  .t-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 10px;
    padding: 16px;
    border-radius: 12px;
    background: var(--bg);
  }
  .t-col {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .bub {
    height: 30px;
    display: block;
  }
  .bub-a {
    border-radius: 8px 8px 8px 2px;
  }
  .bub-b {
    align-self: flex-end;
    border-radius: 8px 8px 2px 8px;
  }
  .judge {
    align-self: center;
    margin-top: 4px;
    width: 22px;
    height: 22px;
    border-radius: 999px;
    border: 1.5px solid var(--ink);
    display: grid;
    place-items: center;
  }
  .r {
    text-align: center;
    font-size: 11px;
    color: var(--muted);
  }
  .t-body {
    font-size: 14px;
    line-height: 1.5;
    color: var(--muted);
  }
  .t-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    border-top: 1px solid var(--line);
    padding-top: 16px;
    font-size: 12px;
  }
  .t-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 500;
    font-size: 14px;
    color: var(--accent);
  }

  .stats {
    display: flex;
    flex-wrap: wrap;
    margin: clamp(48px, 6vw, 80px) 0 0;
    border-top: 1px solid var(--line);
  }
  .stat {
    flex: 1 1 240px;
    padding: 24px 24px 0 0;
    display: flex;
    flex-direction: column-reverse;
    gap: 6px;
  }
  .stat dd {
    margin: 0;
    font-size: 36px;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }
  .stat dt {
    font-size: 13px;
    color: var(--muted);
  }

  @media (max-width: 600px) {
    .ctas {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .ctas .btn {
      justify-content: center;
    }
    .ctas .btn-primary,
    .ctas .btn:last-child {
      grid-column: span 2;
    }
    .bub {
      height: 22px;
    }
    .teaser {
      padding: 20px;
    }
    .stat {
      flex-basis: 100%;
      flex-direction: row-reverse;
      justify-content: space-between;
      align-items: baseline;
      padding: 18px 0;
      border-bottom: 1px solid var(--line);
    }
    .stat dd {
      font-size: 28px;
    }
    .stat dt {
      text-align: right;
      font-size: 12px;
    }
  }
</style>
