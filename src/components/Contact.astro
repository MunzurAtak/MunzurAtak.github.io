---
import { t, links, type Lang } from '../data/content';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = t[lang].contact;
const f = t[lang].footer;
const cvHref = t[lang].hero.cvHref;
const rows = [
  { href: `mailto:${links.email}`, label: links.email, icon: '<path d="M4 6h16v12H4z"></path><path d="M4 7l8 6 8-6"></path>' },
  { href: links.phoneHref, label: links.phone, icon: '<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"></path>' },
  { href: links.linkedin, label: links.linkedinLabel, icon: '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2zM4 6a2 2 0 1 0 0-4 2 2 0 0 0 0 4z"></path>' },
  { href: links.github, label: links.githubLabel, icon: '<path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21"></path>' },
];
---

<section class="wrap section contact" id="contact" aria-labelledby="contact-title">
  <div class="panel card">
    <div class="intro">
      <h2 class="h2" id="contact-title">{c.title}</h2>
      <p class="lead">{c.body}</p>
      <a class="btn btn-primary" href={cvHref} download>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12M7 10l5 5 5-5M5 21h14"></path></svg>
        {c.cv}
      </a>
    </div>
    <ul class="rows">
      {
        rows.map((r) => (
          <li>
            <a href={r.href}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={r.icon} />
              <span>{r.label}</span>
            </a>
          </li>
        ))
      }
      <li class="loc">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"></path><circle cx="12" cy="9.5" r="2.5"></circle></svg>
        <span>{c.location}</span>
      </li>
    </ul>
  </div>
</section>

<footer class="wrap footer mono">
  <span>© {new Date().getFullYear()} Munzur Atak</span>
  <span class="meta">
    <span>{f.built}</span>
    <span>{f.deployed}</span>
    <a href={links.siteRepo}>{f.source}</a>
  </span>
</footer>

<style>
  .contact {
    padding-bottom: 0;
  }
  .panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 32px 56px;
    padding: clamp(24px, 4vw, 48px);
  }
  .intro {
    display: flex;
    flex-direction: column;
    gap: 18px;
    align-items: flex-start;
  }
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
    align-self: center;
  }
  .rows li {
    border-bottom: 1px solid var(--line);
  }
  .rows li:last-child {
    border-bottom: 0;
  }
  .rows a,
  .loc {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 56px;
    text-decoration: none;
    font-size: 16px;
    word-break: break-word;
  }
  .rows a:hover span {
    text-decoration: underline;
  }
  .rows svg {
    flex: none;
    color: var(--muted);
  }
  .loc {
    color: var(--muted);
    font-size: 15px;
  }
  .footer {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px 24px;
    padding-block: 40px 48px;
    font-size: 12.5px;
    color: var(--muted);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
  }
  .footer a {
    color: var(--ink);
  }
  @media (max-width: 820px) {
    .panel {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
