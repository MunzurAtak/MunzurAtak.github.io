---
import { t, type Lang } from '../data/content';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = t[lang];
const items = [
  ['#research', c.nav.research],
  ['#experience', c.nav.experience],
  ['#projects', c.nav.projects],
  ['#skills', c.nav.skills],
  ['#contact', c.nav.contact],
];
---

<header class="wrap">
  <nav class="nav" aria-label="Main">
    <a class="brand" href={`/${lang}/`}>
      <span class="mark mono" aria-hidden="true">MA</span>
      <span class="name">Munzur Atak</span>
    </a>

    <ul class="links" id="nav-links">
      {items.map(([href, label]) => <li><a href={href}>{label}</a></li>)}
    </ul>

    <div class="tools">
      <div class="lang mono" role="group" aria-label={c.langLabel}>
        <a href="/en/" aria-current={lang === 'en' ? 'true' : undefined} hreflang="en" lang="en">EN</a>
        <a href="/nl/" aria-current={lang === 'nl' ? 'true' : undefined} hreflang="nl" lang="nl">NL</a>
      </div>
      <button class="icon-btn" type="button" id="theme-toggle" aria-label={c.themeLabel}>
        <svg class="moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
        <svg class="sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
      </button>
      <button class="icon-btn menu-btn" type="button" id="menu-toggle" aria-label="Menu" aria-expanded="false" aria-controls="nav-links">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
      </button>
    </div>
  </nav>
</header>

<style>
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
    position: relative;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    min-height: 44px;
  }
  .mark {
    width: 34px;
    height: 34px;
    border: 1.5px solid var(--ink);
    border-radius: 8px;
    display: grid;
    place-items: center;
    font-size: 13px;
    font-weight: 500;
  }
  .name {
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .links {
    display: flex;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .links a {
    display: block;
    padding: 10px 12px;
    color: var(--muted);
    text-decoration: none;
    font-size: 15px;
    border-radius: 8px;
  }
  .links a:hover {
    color: var(--ink);
  }
  .tools {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .lang {
    display: flex;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 3px;
    font-size: 12px;
  }
  .lang a {
    display: grid;
    place-items: center;
    min-height: 38px;
    min-width: 44px;
    padding: 0 12px;
    border-radius: 999px;
    color: var(--muted);
    text-decoration: none;
  }
  .lang a[aria-current='true'] {
    background: var(--ink);
    color: var(--bg);
  }
  .icon-btn {
    width: 44px;
    height: 44px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--ink);
    display: grid;
    place-items: center;
    cursor: pointer;
  }
  .icon-btn:hover {
    border-color: var(--ink);
  }
  .sun {
    display: none;
  }
  :global(:root[data-theme='dark']) .sun {
    display: block;
  }
  :global(:root[data-theme='dark']) .moon {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .sun {
      display: block;
    }
    :global(:root:not([data-theme='light'])) .moon {
      display: none;
    }
  }
  .menu-btn {
    display: none;
  }

  @media (max-width: 860px) {
    .menu-btn {
      display: grid;
    }
    .name {
      font-size: 15px;
    }
    .links {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 0;
      padding: 8px 0 16px;
      background: var(--bg);
      border-bottom: 1px solid var(--line);
      z-index: 5;
    }
    .links.open {
      display: flex;
    }
    .links a {
      padding: 14px 4px;
      font-size: 17px;
      color: var(--ink);
    }
  }
  @media (max-width: 420px) {
    .name {
      display: none;
    }
  }
</style>

<script>
  const root = document.documentElement;
  const toggle = document.getElementById('theme-toggle');
  const isDark = () =>
    root.dataset.theme === 'dark' ||
    (!root.dataset.theme && window.matchMedia('(prefers-color-scheme: dark)').matches);
  toggle?.addEventListener('click', () => {
    const next = isDark() ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });

  const menuBtn = document.getElementById('menu-toggle');
  const links = document.getElementById('nav-links');
  menuBtn?.addEventListener('click', () => {
    const open = links?.classList.toggle('open') ?? false;
    menuBtn.setAttribute('aria-expanded', String(open));
  });
  links?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) {
      links.classList.remove('open');
      menuBtn?.setAttribute('aria-expanded', 'false');
    }
  });
</script>
